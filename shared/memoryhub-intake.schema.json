{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoryhub.local/schemas/intake-envelope-v1.json",
  "title": "Memory Hub Intake Envelope",
  "type": "object",
  "required": ["schemaVersion", "envelopeId", "createdAt", "source", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "envelopeId": { "type": "string", "format": "uuid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["kind", "label"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["codex", "share", "file", "manual"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "threadId": { "type": "string", "maxLength": 160 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "target", "title", "payload"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "target": { "enum": ["calendar", "document", "purchase", "fridge", "homeItem"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "note": { "type": "string", "maxLength": 4000 },
          "payload": { "type": "object" }
        }
      }
    }
  }
}
