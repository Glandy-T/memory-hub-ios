import 'dart:convert';
import 'dart:io';

import 'package:integration_test/integration_test_driver_extended.dart';

Future<void> main() => integrationDriver(
  onScreenshot:
      (String name, List<int> bytes, [Map<String, Object?>? args]) async {
        await File(
          'build/android-motion-$name.png',
        ).writeAsBytes(bytes, flush: true);
        return true;
      },
  responseDataCallback: (Map<String, dynamic>? data) async {
    final screenshots = data?['boundary_screenshots'];
    if (screenshots is! Map<String, dynamic>) return;
    for (final entry in screenshots.entries) {
      await File(
        'build/android-motion-${entry.key}.png',
      ).writeAsBytes(base64Decode(entry.value as String), flush: true);
    }
  },
);
