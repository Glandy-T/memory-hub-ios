import 'dart:io';

import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:integration_test/integration_test.dart';
import 'package:intl/date_symbol_data_local.dart';

import 'package:memory_hub/app/memory_hub_app.dart';
import 'package:memory_hub/data/memory_repository.dart';
import 'package:memory_hub/state/memory_controller.dart';

void main() {
  IntegrationTestWidgetsFlutterBinding.ensureInitialized();
  const scenario = String.fromEnvironment('MEMORY_HUB_QA_SCENARIO');

  setUpAll(() async {
    await initializeDateFormatting('zh_CN');
  });

  if (scenario == 'home') {
    testWidgets('Android renders the home card diagonal tilt', (tester) async {
      final controller = await MemoryController.create(InMemoryRepository());
      await controller.addTask(
        title: '整理体检资料',
        date: controller.effectiveToday(),
        minutesFromMidnight: 14 * 60,
      );
      await tester.pumpWidget(MemoryHubApp(controller: controller));
      await tester.pumpAndSettle();
      debugPrint('ANDROID_QA app-settled');

      final card = find.byKey(
        ValueKey('task-card-motion-${controller.data.tasks.single.id}'),
      );
      expect(card, findsOneWidget);
      final resting = List<double>.of(
        tester.widget<AnimatedContainer>(card).transform!.storage,
      );
      final cardBounds = tester.getRect(card);
      final cardGesture = await tester.startGesture(cardBounds.center);
      await cardGesture.moveBy(const Offset(82, -76));
      await tester.pump(const Duration(milliseconds: 90));
      debugPrint('ANDROID_QA card-tilted');
      expect(
        tester.widget<AnimatedContainer>(card).transform!.storage,
        isNot(equals(resting)),
      );
      // Hosted SwiftShader can acknowledge the Flutter frame before the host
      // display surface presents it. Keep the live diagonal pointer state
      // unchanged while the compositor catches up.
      await _signalQa('ANDROID_QA home-ready-for-screenshot');
      await Future<void>.delayed(const Duration(seconds: 15));
      await cardGesture.up();
      await tester.pumpAndSettle();
      debugPrint('ANDROID_QA card-released');
      expect(
        tester.widget<AnimatedContainer>(card).transform!.storage,
        equals(resting),
      );
    });
  }

  if (scenario == 'calendar-drag') {
    testWidgets('Android renders the adjacent month during drag', (
      tester,
    ) async {
      final controller = await MemoryController.create(InMemoryRepository());
      await tester.pumpWidget(MemoryHubApp(controller: controller));
      await tester.pumpAndSettle();
      await tester.tap(find.bySemanticsLabel('日历'));
      await tester.pumpAndSettle();
      debugPrint('ANDROID_QA calendar-settled');
      final panel = find.byKey(const ValueKey('calendar-month-motion'));
      final paintedContent = find.byKey(
        const ValueKey('calendar-month-painted-content'),
      );
      expect(
        find.byKey(const ValueKey('calendar-month-adjacent-1')),
        findsOneWidget,
      );
      debugPrint('ANDROID_QA calendar-track-ready');
      expect(panel, findsOneWidget);
      expect(paintedContent, findsOneWidget);
      expect(tester.getTopLeft(paintedContent).dx, lessThan(0));
      final nextPanel = find.byKey(const ValueKey('calendar-month-adjacent-1'));
      final logicalWidth =
          tester.view.physicalSize.width / tester.view.devicePixelRatio;
      expect(tester.getRect(nextPanel).left, lessThan(logicalWidth));
      await _signalQa('ANDROID_QA calendar-drag-frame-ready');
      await Future<void>.delayed(const Duration(seconds: 15));
    });
  }

  if (scenario == 'calendar-settled') {
    testWidgets('Android settles the adjacent month in the center', (
      tester,
    ) async {
      final controller = await MemoryController.create(InMemoryRepository());
      await tester.pumpWidget(MemoryHubApp(controller: controller));
      await tester.pumpAndSettle();
      final today = controller.effectiveToday();
      final nextMonth = DateTime(today.year, today.month + 1);
      await tester.tap(find.bySemanticsLabel('日历'));
      await tester.pumpAndSettle();
      final paintedContent = find.byKey(
        const ValueKey('calendar-month-painted-content'),
      );
      final panel = find.byKey(const ValueKey('calendar-month-motion'));
      expect(
        find.text('${nextMonth.year}年${nextMonth.month}月'),
        findsOneWidget,
      );
      expect(
        tester.getTopLeft(paintedContent).dx,
        closeTo(tester.getTopLeft(panel).dx, .5),
      );
      expect(tester.takeException(), isNull);
      await _signalQa('ANDROID_QA calendar-native-settle-asserted');
      await Future<void>.delayed(const Duration(seconds: 15));
    });
  }
}

Future<void> _signalQa(String marker) async {
  debugPrint(marker);
  final markerFile = File('${Directory.systemTemp.path}/memory-hub-qa-marker');
  await markerFile.writeAsString(marker, flush: true);
}
